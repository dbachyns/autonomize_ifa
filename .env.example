# Copy to .env and fill in what you need: cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Reader selection -------------------------------------------------------
# Which reader extracts forms: openai | claude | ollama | hybrid
FORM_AGENT_READER=openai

# --- OpenAI (API) -------------------------------------------------------------
# Needed for the openai reader and the Q&A agent. Get one at https://platform.openai.com
OPENAI_API_KEY=
# gpt-6.1-sol: most accurate ($2 / $10 per 1M tokens) · gpt-6-luna: cheap ($0.10 / $0.50)
OPENAI_MODEL=gpt-6-luna
# Model for answering questions and writing summaries (defaults to OPENAI_MODEL)
FORM_AGENT_MODEL=

# --- Claude (API, optional) ---------------------------------------------------
# Needed only for the claude reader. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Ollama (local, no key needed) --------------------------------------------
# Install from https://ollama.com, then: ollama pull qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# --- Paths --------------------------------------------------------------------
FORM_AGENT_DATA_DIR=data
FORM_AGENT_CACHE_DIR=data/cache
FORM_AGENT_DB=data/forms.db
